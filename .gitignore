# --- secrets: never commit ------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
secrets/

# --- python ---------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/

# --- runtime artifacts ----------------------------------------------------
# The audit trail / cost ledger. Real request content, regenerated on every
# run — not source, and potentially sensitive.
events.jsonl
*.log

# --- load test output -----------------------------------------------------
k6-results/
*.jtl

# --- generated evidence ---------------------------------------------------
# `python prove.py` writes these on every run. They are OUTPUT, not source:
# continuous integration publishes them to the job summary and keeps them as
# a build artefact, which is where a record of a specific run belongs. A
# committed copy would be stale within a day and would invite someone to
# read it as current.
evidence/

# Per-sample k6 output: ~2MB and regenerated by every run. The small
# derived summary IS committed, because the saturation chart is drawn from
# it and a published figure must have a source in the repository.
loadtest/k6-raw.json
loadtest/k6-run.log

# --- load test tooling ----------------------------------------------------
# The k6 binary is 64MB. A tool belongs in the environment, not in the
# repository: committing it would make every clone pay for it forever and
# pin one platform's build into a cross-platform project. The CI workflow
# installs k6 itself, and loadtest/README.md says how to get it locally.
loadtest/bin/

# --- editors / OS ---------------------------------------------------------
.vscode/
.idea/
Thumbs.db
desktop.ini

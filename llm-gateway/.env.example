# Environment variables the gateway reads.
#
# COPY to .env and fill in — .env is gitignored, this file is not.
# Nothing here holds a real value. Secrets never live in the repo; the
# Anthropic adapter reads ANTHROPIC_API_KEY from the environment, which is
# why config.yaml has no credential field.

# --- secrets --------------------------------------------------------------

# Anthropic API key for the cloud provider. Without it, `claude` reports
# unhealthy and every request serves on-prem — which looks like the policy
# working, but is actually just a missing credential. Set it so the cloud
# path is genuinely exercised.
ANTHROPIC_API_KEY=sk-ant-...

# Bearer token for the gateway itself. UNSET = no auth, and /healthz reports
# auth_enabled:false so an open gateway is never a silent condition.
MG_API_KEY=demo-secret-key

# --- operational limits ---------------------------------------------------

# Max concurrent in-flight requests before shedding with 429. On 2 physical
# cores with 6-10s inference, unbounded concurrency means memory growth and
# uniform timeouts; shedding gives a real saturation point for the load test.
MG_MAX_INFLIGHT=8

# How often the background task refreshes provider health, in seconds.
# Used for ORDERING only — attempting a call is still the real health check.
MG_HEALTH_INTERVAL_S=15

# Routing strategy: policy | cheapest-first | local-first
# Swapping this changes routing behaviour with no code change.
MG_STRATEGY=policy

# --- paths ----------------------------------------------------------------

MG_CONFIG=config.yaml
MG_POLICY=policy.yaml

# Ollama runs on the HOST, outside the container network. On the host the
# default applies; in Compose set this to host.docker.internal.
OLLAMA_BASE_URL=http://localhost:11434
